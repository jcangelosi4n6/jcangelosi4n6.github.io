---
layout: null
---
<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title | xml_escape }}</title>
    <link>{{ "/" | absolute_url }}</link>
    <description>Recent content on {{ site.title | xml_escape }}</description>
    <generator>Jekyll</generator>
    <language>{{ site.lang | default: "en" }}</language>
    {% if site.posts.size > 0 %}<lastBuildDate>{{ site.posts.first.date | date_to_rfc822 }}</lastBuildDate>{% endif %}
    <atom:link href="{{ "/index.xml" | absolute_url }}" rel="self" type="application/rss+xml" />
    {% for post in site.posts %}
    <item>
      <title>{{ post.title | xml_escape }}</title>
      <link>{{ post.url | absolute_url }}</link>
      <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
      <guid>{{ post.url | absolute_url }}</guid>
      <description>{{ post.description | default: post.excerpt | strip_html | normalize_whitespace | xml_escape }}</description>
    </item>
    {% endfor %}
  </channel>
</rss>
